# Copy outside tracked files; use absolute paths. No real credentials in this example.
IMAGE_TAG=local
# Optional: update API/jobs independently of CMS and SSR images.
# API_IMAGE_TAG=local-iii7
# SECURITY_CLEANUP_ENV_FILE=/absolute/private/security-cleanup.env
POSTGRES_PASSWORD=REPLACE_RANDOM_HEX
API_OWNER_PASSWORD=REPLACE_RANDOM_HEX
API_DATABASE_PASSWORD=REPLACE_RANDOM_HEX
CMS_DATABASE_PASSWORD=REPLACE_RANDOM_HEX
SECURITY_CLEANUP_PASSWORD=REPLACE_RANDOM_HEX
API_ENV_FILE=/absolute/private/api.env
CMS_ENV_FILE=/absolute/private/cms.env
PUBLIC_ORIGIN=https://localhost:8443
CMS_PUBLIC_ORIGIN=https://localhost:9443
PROXY_BIND=127.0.0.1
HTTPS_PORT=8443
CMS_HTTPS_PORT=9443
# Pick an unused subnet before creating the project; proxy must belong to it.
APPLICATION_SUBNET=172.30.85.0/24
APPLICATION_DYNAMIC_RANGE=172.30.85.128/25
APPLICATION_BRIDGE_NAME=br-sinegor-app
PROXY_INTERNAL_IP=172.30.85.2
YANDEX_METRIKA_ENABLED=false
YANDEX_METRIKA_ID=
TLS_CERT_FILE=/absolute/private/cert.pem
TLS_KEY_FILE=/absolute/private/key.pem
CMS_CLIENT_CA_FILE=/absolute/private/cms-client-ca.pem
