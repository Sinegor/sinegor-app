[Unit]
Description=SINEGOR technical log retention (90 days)
[Service]
Type=oneshot
User=root
UMask=0077
StateDirectory=sinegor-log-retention
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 -B /usr/local/lib/sinegor/logging/retention.py cleanup
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log
PrivateNetwork=true
