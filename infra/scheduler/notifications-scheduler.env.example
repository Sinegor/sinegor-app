# Host paths for the FUTURE production Compose deployment. No channel credentials here.
SINEGOR_PROJECT_DIR=/srv/sinegor-app
SINEGOR_COMPOSE_FILE=/srv/sinegor-app/infra/compose/production.yaml
SINEGOR_COMPOSE_ENV_FILE=/etc/sinegor/compose.env
SINEGOR_API_SERVICE=api
SINEGOR_PYTHON=/app/.venv/bin/python
# Change only after an explicit review of pending/processing jobs and approval to send.
NOTIFICATION_QUEUE_REVIEWED=no
