[Unit]
Description=SINEGOR coherent PostgreSQL and file backup
Wants=docker.service network-online.target
Requires=sinegor-backup-recovery.service
After=docker.service network-online.target sinegor-backup-recovery.service
OnFailure=sinegor-backup-watchdog.service

[Service]
Type=oneshot
User=root
UMask=0077
Environment=PATH=/usr/local/lib/sinegor/backup/bin:/usr/local/bin:/usr/bin:/bin
Environment=SINEGOR_BACKUP_CONFIG=/etc/sinegor/backup/config.json
ExecStart=/usr/bin/python3 /usr/local/lib/sinegor/backup/production.py run --config /etc/sinegor/backup/config.json
ExecStopPost=/usr/bin/python3 /usr/local/lib/sinegor/backup/production.py recover --config /etc/sinegor/backup/config.json
TimeoutStartSec=20min
TimeoutStopSec=180s
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sinegor-backup
