[Unit]
Description=SINEGOR read-only production HTTP Docker disk and TLS monitor
Wants=docker.service network-online.target
After=docker.service network-online.target sinegor-backup-recovery.service

[Service]
Type=oneshot
User=root
UMask=0077
StateDirectory=sinegor-monitor
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 -B /usr/local/lib/sinegor/monitoring/production.py check
TimeoutStartSec=90s
TimeoutStopSec=10s
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sinegor-monitor
