# Host selectors only; channel credentials stay in the API environment.
SINEGOR_PROJECT_NAME=sinegor-lab-prod
SINEGOR_PROJECT_DIR=/home/sinegoradmin/apps/sinegor-app
SINEGOR_COMPOSE_ENV_FILE=/home/sinegoradmin/apps/sinegor-app-private/compose.env
SINEGOR_COMPOSE_FILE=/home/sinegoradmin/apps/sinegor-app/infra/compose/production.yaml
SINEGOR_COMPOSE_OVERRIDE=/home/sinegoradmin/apps/sinegor-app-private/https/production.https.yaml
SINEGOR_API_SERVICE=api
SINEGOR_PYTHON=/app/.venv/bin/python
# Private 0600 file with only DATABASE_URL for sinegor_security_cleanup, never owner.
SECURITY_CLEANUP_ENV_FILE=/home/sinegoradmin/apps/sinegor-app-private/security-cleanup.env
# Set only after actual queue/PDF preflight and isolated tests. Enabling timers can run immediately.
JOBS_ACTIVATION_REVIEWED=no
