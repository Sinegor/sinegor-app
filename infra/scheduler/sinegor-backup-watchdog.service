[Unit]
Description=SINEGOR host backup and recovery watchdog
Wants=docker.service network-online.target sinegor-backup-recovery.service
After=docker.service network-online.target sinegor-backup-recovery.service

[Service]
Type=oneshot
User=root
UMask=0077
Environment=PATH=/usr/local/lib/sinegor/backup/bin:/usr/local/bin:/usr/bin:/bin
Environment=SINEGOR_BACKUP_CONFIG=/etc/sinegor/backup/config.json
ExecStart=/usr/bin/python3 /usr/local/lib/sinegor/backup/production.py watchdog --config /etc/sinegor/backup/config.json
TimeoutStartSec=5min
TimeoutStopSec=15s
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sinegor-backup-watchdog
