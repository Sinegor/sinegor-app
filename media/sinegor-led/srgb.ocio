# Minimal scene-linear Rec.709 / sRGB config; compatible with OCIO 2.4+.
ocio_profile_version: 2
search_path: ""
strictparsing: true
roles:
  default: Linear
  scene_linear: Linear
  rendering: Linear
  default_float: Linear
  default_byte: sRGB
  default_sequencer: sRGB
  color_picking: sRGB
  data: Non-Color
displays:
  sRGB:
    - !<View> {name: Standard, colorspace: sRGB}
active_displays: [sRGB]
active_views: [Standard]
colorspaces:
  - !<ColorSpace>
    name: Linear
    family: linear
    bitdepth: 32f
    isdata: false
    allocation: uniform
  - !<ColorSpace>
    name: sRGB
    family: display
    bitdepth: 8ui
    isdata: false
    allocation: uniform
    to_scene_reference: !<ExponentWithLinearTransform> {gamma: [2.4, 2.4, 2.4, 1], offset: [0.055, 0.055, 0.055, 0], direction: forward}
  - !<ColorSpace>
    name: Non-Color
    family: data
    bitdepth: 32f
    isdata: true
    allocation: uniform
