API_ORIGIN=http://127.0.0.1:8000
# Public website origin for absolute SSR canonical URLs and redirects.
PUBLIC_ORIGIN=http://localhost:3000
# Server-only Strapi address; leave unset for the standalone F4 development views.
CMS_ORIGIN=http://127.0.0.1:1337
# Public address for CMS media when its internal address differs (e.g. reverse proxy).
CMS_MEDIA_ORIGIN=http://localhost:1337
