APP_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+psycopg://sinegor:sinegor_dev@127.0.0.1:5432/sinegor
LOG_LEVEL=DEBUG
DB_CONNECT_TIMEOUT=5

# Для входа администратора сгенерировать и заполнить ключи (docs/authentication.md).
SESSION_SECRET=
AUTH_ENCRYPTION_KEY=
MAGIC_LINK_TTL_SECONDS=900
SESSION_TTL_SECONDS=86400
ADMIN_SESSION_TTL_SECONDS=28800
# Отдельный пароль приложения Яндекс 360; пустые значения отключают отправку.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
