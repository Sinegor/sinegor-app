APP_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+psycopg://sinegor:sinegor_dev@127.0.0.1:55432/sinegor
LOG_LEVEL=DEBUG
DB_CONNECT_TIMEOUT=5
# По умолчанию apps/api/storage/agreements; абсолютный путь можно задать отдельно.
AGREEMENT_MAX_BYTES=20971520

# Для входа администратора сгенерировать и заполнить ключи (docs/authentication.md).
SESSION_SECRET=
AUTH_ENCRYPTION_KEY=
MAGIC_LINK_TTL_SECONDS=900
SESSION_TTL_SECONDS=86400
ADMIN_SESSION_TTL_SECONDS=28800
CSRF_TTL_SECONDS=3600
# Лимиты действуют и в development; учитываются успешные и неуспешные запросы.
# Окно в секундах; счётчики отдельные для каждого действия авторизации/приглашения.
AUTH_RATE_WINDOW_SECONDS=900
AUTH_IP_LIMIT=30
AUTH_ACCOUNT_LIMIT=5
# Отдельный пароль приложения почты; пустые значения отключают отправку.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_TIMEOUT=10
SMTP_FROM_NAME=SINEGOR
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# B6: OAuth-токен сервера и существующая папка заказов (не корень Диска).
YANDEX_DISK_TOKEN=
YANDEX_DISK_ROOT=
YANDEX_DISK_TIMEOUT=10
# Только для изолированной проверки; вне корня рабочих заказов.
YANDEX_DISK_TEST_ROOT=

# B7: адрес администратора по умолчанию совпадает с SMTP_FROM_EMAIL.
NOTIFICATION_ADMIN_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_TIMEOUT=10
