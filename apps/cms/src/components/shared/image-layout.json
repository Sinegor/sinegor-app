{
  "collectionName": "components_shared_image_layouts",
  "info": {
    "displayName": "Оформление изображения",
    "description": "Положение относительно текста, максимальный размер и подпись. В узких блоках изображение располагается сверху."
  },
  "attributes": {
    "position": {
      "type": "enumeration",
      "enum": ["top", "left", "right"],
      "required": true,
      "default": "top"
    },
    "size": {
      "type": "enumeration",
      "enum": ["small", "medium", "large", "full"],
      "required": true,
      "default": "medium"
    },
    "alignment": {
      "type": "enumeration",
      "enum": ["left", "center", "right"],
      "required": true,
      "default": "center"
    },
    "caption": {
      "type": "text"
    }
  }
}
