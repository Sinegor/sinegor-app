{
  "collectionName": "components_shared_image_layouts",
  "info": {
    "displayName": "Оформление изображения",
    "description": "Положение относительно текста, максимальный размер и подпись. В узких блоках изображение располагается сверху."
  },
  "attributes": {
    "position": {
      "type": "enumeration",
      "required": true,
      "default": "top",
      "enum": [
        "top",
        "left",
        "right"
      ]
    },
    "size": {
      "type": "enumeration",
      "required": true,
      "default": "medium",
      "enum": [
        "small",
        "medium",
        "large",
        "full"
      ]
    },
    "alignment": {
      "type": "enumeration",
      "required": true,
      "default": "center",
      "enum": [
        "left",
        "center",
        "right"
      ]
    },
    "caption": {
      "type": "text"
    }
  }
}
