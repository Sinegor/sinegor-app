{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Страница"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "linkSection": {
      "type": "enumeration",
      "enum": [
        "home",
        "ai-analysis",
        "technical",
        "about",
        "publications",
        "contacts"
      ],
      "default": "publications"
    },
    "linkOrder": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "sections": {
      "type": "component",
      "component": "shared.section",
      "repeatable": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "imageLayout": {
      "type": "component",
      "component": "shared.image-layout"
    },
    "video": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["videos"]
    },
    "videoCaption": {
      "type": "text"
    },
    "contactEmail": {
      "type": "email"
    },
    "contactPhone": {
      "type": "string"
    }
  }
}
