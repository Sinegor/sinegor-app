# Шаблон: локальные секреты задаются в .env, реальные значения не коммитить.
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
# Две базы и отдельные пользователи одного PostgreSQL.
DATABASE_URL=postgresql+psycopg://sinegor:CHANGE_ME@postgres:5432/sinegor
CMS_DATABASE_URL=postgresql://strapi:CHANGE_ME@postgres:5432/strapi
# Доступ к CMS только с сервера SSR; без публичных frontend-префиксов.
CMS_INTERNAL_URL=http://cms:1337
CMS_API_TOKEN=
API_INTERNAL_URL=http://api:8000
AGREEMENT_STORAGE_DIR=/var/lib/sinegor/agreements
AGREEMENT_MAX_BYTES=20971520
SESSION_SECRET=
AUTH_ENCRYPTION_KEY=
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
YANDEX_DISK_OAUTH_TOKEN=
YANDEX_DISK_ORDERS_ROOT=
